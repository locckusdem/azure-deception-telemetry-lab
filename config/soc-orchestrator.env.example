# SOC Orchestrator Runtime Configuration
# Copy to /etc/clinica/soc-orchestrator.env on the target host and customize.

SOC_TARGET_USER=marianela_recepcion
SOC_HONEYTOKEN_PATH=/opt/clinica/datos/pacientes_db_credenciales.env
SOC_AUDIT_LOG_PATH=/var/log/audit/audit.log
SOC_AUDIT_KEY=honeytoken_acceso
SOC_FORENSIC_LOG_PATH=/opt/clinica/logs/soc_actions.log

# Comma-separated port:service pairs for internal passive honeyport sockets
SOC_HONEYPORTS=445:SMB,3389:RDP
SOC_BIND_HOST=0.0.0.0

# Optional push notification webhook (leave empty to disable external alerts)
SOC_NTFY_URL=https://ntfy.sh/replace-with-your-private-topic

# Burst suppression window in seconds to avoid duplicate tickets on syscall storms
SOC_COOLDOWN_SECONDS=5.0

# Set to true/1 to simulate containment and alerts without modifying PAM or killing processes
SOC_DRY_RUN=false
